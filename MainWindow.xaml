<Window x:Class="HD2MM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HD2MM.ViewModels"
        xmlns:m="clr-namespace:HD2MM.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LunaMyMaster"
        Width="1120" Height="660"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        StateChanged="OnWindowStateChanged"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" GlassFrameThickness="0"
                        CornerRadius="0" ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.DataContext>
    <vm:MainWindowViewModel />
  </Window.DataContext>

  <Border x:Name="RootBorder" BorderBrush="#3A3A3A" BorderThickness="1"
          CornerRadius="8" Background="{StaticResource HdBg}"
          SizeChanged="OnRootBorderSizeChanged">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- ═══ top toolbar ═══ -->
    <Border Grid.Row="0" Background="{StaticResource HdSurface}"
            BorderBrush="{StaticResource HdBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="10,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- left: collapse toggle + search -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CollapseButton" Content="☰" Style="{StaticResource GhostButton}"
                  FontSize="14" Width="34" Height="30" Padding="0"
                  Click="OnToggleSidebar" ToolTip="折叠/展开侧栏" />
          <Grid Width="290" Margin="6,0,0,0" VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBox x:Name="SearchBoxCtl" Style="{StaticResource SearchBox}"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="搜索模组 / Nexus 编号…" FontSize="12" Margin="14,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{StaticResource HdTextMuted}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBoxCtl}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </StackPanel>

        <!-- center: title -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Luna My Master" FontFamily="Palace Script MT, Segoe Script, Segoe UI"
                     FontSize="27" Foreground="{StaticResource HdAccent}"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- right: actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="导入模组" Style="{StaticResource GhostButton}"
                  Margin="0,0,6,0" Command="{Binding ImportCommand}" />
          <Button Content="重新扫描" Style="{StaticResource GhostButton}"
                  Margin="0,0,6,0" Command="{Binding RescanCommand}" />
          <Button Content="应用更改" Style="{StaticResource AccentButton}"
                  Command="{Binding ApplyCommand}" />

          <Border Width="1" Height="20" Background="{StaticResource HdBorder}" Margin="9,0" />
          <Button Content="&#xE921;" Style="{StaticResource GhostButton}" Width="46" Height="32"
                  Padding="0" FontSize="10" FontFamily="Segoe MDL2 Assets"
                  Click="OnMinimize" ToolTip="最小化" />
          <Button Content="&#xE922;" Style="{StaticResource GhostButton}" Width="46" Height="32"
                  Padding="0" FontSize="10" FontFamily="Segoe MDL2 Assets"
                  Click="OnMaximize" ToolTip="最大化" />
          <Button Content="&#xE8BB;" Style="{StaticResource GhostButton}" Width="46" Height="32"
                  Padding="0" FontSize="10" FontFamily="Segoe MDL2 Assets"
                  Click="OnCloseWindow" ToolTip="关闭" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ body ═══ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- left nav -->
      <Border x:Name="Sidebar" Grid.Column="0" BorderBrush="{StaticResource HdBorder}" BorderThickness="0,0,1,0"
              Padding="10,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Background="{StaticResource HdAccent}" CornerRadius="4"
                    Padding="9,4" Margin="4,0,6,8">
              <TextBlock Text="📚 库" FontSize="12" FontWeight="Bold" Foreground="#111111"
                         FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji" />
            </Border>
            <RadioButton Content="全部模组" Style="{StaticResource NavRadio}" GroupName="Nav"
                         IsChecked="True"
                         Command="{Binding SetFilterCommand}" CommandParameter="All" />
            <RadioButton Content="近期更新" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Command="{Binding SetFilterCommand}" CommandParameter="Recent" />
            <RadioButton Content="已启用" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Command="{Binding SetFilterCommand}" CommandParameter="Enabled" />
            <RadioButton Content="未启用" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Command="{Binding SetFilterCommand}" CommandParameter="Disabled" />

            <Border Background="{StaticResource HdAccent}" CornerRadius="4"
                    Padding="9,4" Margin="4,14,6,8">
              <TextBlock Text="🔧 工具" FontSize="12" FontWeight="Bold" Foreground="#111111"
                         FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji" />
            </Border>
            <Button Content="层链检查" Style="{StaticResource NavButton}"
                    Command="{Binding InspectLayersCommand}" />
            <Button Content="占用检查" Style="{StaticResource NavButton}"
                    Command="{Binding InspectOccupancyCommand}" />
            <Button Content="设置 API Key" Style="{StaticResource NavButton}"
                    Command="{Binding ApiKeyCommand}" />
            <Button Content="检查更新" Style="{StaticResource NavButton}"
                    Command="{Binding CheckUpdatesCommand}" />
            <Button Content="{Binding CloseBehaviorText}" Style="{StaticResource NavButton}"
                    Command="{Binding ToggleCloseBehaviorCommand}"
                    ToolTip="切换：点 ✕ 时直接退出还是收进后台托盘" />
          </StackPanel>
          </ScrollViewer>

          <!-- ═══ cold-war "restore vanilla" button ═══ -->
          <Button Grid.Row="1" Height="52" Margin="10,14,10,4"
                  Command="{Binding RestoreVanillaCommand}" Cursor="Hand"
                  BorderThickness="0" Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Grid>
                  <Border x:Name="Glow" CornerRadius="26" Background="#22E5484D" Margin="-5" />
                  <Border x:Name="Body" CornerRadius="26" Background="#B3261E"
                          BorderBrush="#FF8A80" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="⚠  恢复原版" FontSize="13" FontWeight="Bold"
                                 Foreground="#FFFFFF" HorizontalAlignment="Center" />
                      <TextBlock Text="RESTORE VANILLA" FontSize="7" Foreground="#FFD9D9"
                                 HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Body" Property="Background" Value="#D32F2F" />
                    <Setter TargetName="Body" Property="BorderBrush" Value="#FFD94A" />
                    <Setter TargetName="Glow" Property="Background" Value="#44E5484D" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Body" Property="Background" Value="#7F150F" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <StackPanel Grid.Row="2" Margin="12,8,8,4">
            <TextBlock Text="模组库" FontSize="9" Foreground="{StaticResource HdTextMuted}" />
            <TextBlock Text="{Binding ModsDirText}" FontSize="9" TextWrapping="Wrap"
                       Foreground="{StaticResource HdTextMuted}" Margin="0,2,0,8" />
            <TextBlock Text="游戏目录" FontSize="9" Foreground="{StaticResource HdTextMuted}" />
            <TextBlock Text="{Binding GameDirText}" FontSize="9" TextWrapping="Wrap"
                       Foreground="{StaticResource HdTextMuted}" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- card grid = drop zone -->
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="WorkArea" Padding="18" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnWorkAreaScrollChanged"
                      AllowDrop="True"
                      DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <ItemsControl ItemsSource="{Binding ModsView}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type m:ModItem}">
              <Border Style="{StaticResource Card}" Width="258" Height="150" Margin="0,0,12,12"
                      MouseLeftButtonDown="OnCardMouseDown">
                <Border.ContextMenu>
                  <ContextMenu Style="{StaticResource HdContextMenu}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="编辑备注…" Style="{StaticResource HdMenuItem}"
                              Click="OnMenuEditNote" />
                    <Separator>
                      <Separator.Style>
                        <Style TargetType="Separator" BasedOn="{StaticResource HdSeparator}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNexus}" Value="False">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Separator.Style>
                    </Separator>
                    <MenuItem Header="打开 Nexus 页面" Click="OnMenuOpenNexus">
                      <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource HdMenuItem}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNexus}" Value="False">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <Separator Style="{StaticResource HdSeparator}" />
                    <MenuItem Header="删除模组…" Foreground="#E5484D" Click="OnMenuDelete">
                      <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource HdMenuItem}">
                          <Setter Property="Foreground" Value="#E5484D" />
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="14,12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{StaticResource HdAccent}" VerticalAlignment="Top">
                      <Grid>
                        <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold"
                                   Foreground="#111111"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding IconPath}" Stretch="UniformToFill">
                          <Image.Style>
                            <Style TargetType="Image">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" Foreground="{StaticResource HdText}" />
                      <TextBlock Text="{Binding MetaLine}" FontSize="10" Margin="0,2,0,0"
                                 Foreground="{StaticResource HdTextMuted}" />
                      <TextBlock Text="{Binding SuspectText}" FontSize="9" Margin="0,2,0,0"
                                 TextWrapping="Wrap" Foreground="#E5484D">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSuspect}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>

                  <TextBlock Grid.Row="1" Text="{Binding CardText}" FontSize="10" Margin="0,10,0,0"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"
                             Foreground="{StaticResource HdTextMuted}" />

                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- status LED: green = enabled, red = disabled -->
                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="#E5484D" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                              <Setter Property="Fill" Value="#4CAF50" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>

                    <Button Grid.Column="1" Content="选项"
                            Command="{Binding DataContext.EditOptionsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                          <Setter Property="FontSize" Value="9" />
                          <Setter Property="Padding" Value="6,2" />
                          <Setter Property="Margin" Value="0,0,8,0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOptions}" Value="False">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  HorizontalAlignment="Right" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <!-- drag & drop hint -->
        <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#D9000000" BorderBrush="{StaticResource HdAccent}"
                BorderThickness="2" CornerRadius="10" Margin="10">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="松开鼠标导入" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource HdAccent}" HorizontalAlignment="Center" />
            <TextBlock Text="支持 zip / rar / 7z，可一次拖多个" FontSize="12" Margin="0,8,0,0"
                       Foreground="{StaticResource HdTextMuted}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- ═══ detail pane (double-click a card) ═══ -->
        <Border x:Name="DetailPanel" Visibility="Collapsed" Background="{StaticResource HdBg}"
                Opacity="1">
          <Grid Margin="26,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Width="64" Height="64" CornerRadius="10"
                      Background="{StaticResource HdAccent}" VerticalAlignment="Top">
                <Grid>
                  <TextBlock Text="{Binding SelectedMod.Initials}" FontSize="24" FontWeight="Bold"
                             Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding SelectedMod.IconPath}" Stretch="UniformToFill">
                    <Image.Style>
                      <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedMod.HasIcon}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Image.Style>
                  </Image>
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedMod.Name}" FontSize="17" FontWeight="Bold"
                           TextWrapping="Wrap" Foreground="{StaticResource HdText}" />
                <TextBlock Text="{Binding SelectedMod.MetaLine}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource HdTextMuted}" />
              </StackPanel>

              <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                      FontSize="14" Width="32" Height="30" Padding="0"
                      VerticalAlignment="Top" Click="OnCloseDetail" />
            </Grid>

            <Border Grid.Row="1" Margin="0,18,0,0" Padding="16,14" CornerRadius="8"
                    Background="{StaticResource HdSurface}"
                    BorderBrush="{StaticResource HdBorder}" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontSize="12"
                           LineHeight="21" Foreground="{StaticResource HdText}" />
              </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,14,0,0">
              <Button Content="编辑备注…" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                      Click="OnDetailEditNote" />
              <Button Content="打开 Nexus 页面" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                      Click="OnDetailOpenNexus" />
              <Button Content="关闭" Style="{StaticResource AccentButton}" Click="OnCloseDetail" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ═══ status bar ═══ -->
    <Border Grid.Row="2" Background="{StaticResource HdSurface}"
            BorderBrush="{StaticResource HdBorder}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0">
        <TextBlock Text="{Binding StatusLine}" FontSize="10" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource HdTextMuted}" />
      </Grid>
    </Border>

  </Grid>
  </Border>
</Window>
