<Window x:Class="HD2MM.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HD2MM"
        Width="440" SizeToContent="Height" MinHeight="190"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource HdBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="30" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Margin="20,52,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
               Foreground="{StaticResource HdText}" />

    <TextBlock x:Name="PromptText" Grid.Row="1" FontSize="11" Margin="0,6,0,0"
               TextWrapping="Wrap" Foreground="{StaticResource HdTextMuted}" />

    <TextBox x:Name="ValueBox" Grid.Row="2" Margin="0,12,0,0" Height="34"
             Style="{StaticResource SearchBox}"
             VerticalContentAlignment="Center" Padding="12,0" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="取消" Style="{StaticResource GhostButton}" Width="80" Margin="0,0,8,0"
              Click="OnCancel" />
      <Button Content="确定" Style="{StaticResource AccentButton}" Width="80"
              Click="OnOk" />
    </StackPanel>
  </Grid>
</Window>
