<Window x:Class="HD2MM.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="确认"
        Width="460" SizeToContent="Height" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource HdBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="30" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Margin="14,44,14,14" CornerRadius="10" Background="{StaticResource HdSurface}"
          BorderBrush="#E5484D" BorderThickness="2">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Border Width="10" Height="10" CornerRadius="5" Background="#E5484D"
                VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                   Foreground="#FF6B6B" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="BodyText" Grid.Row="1" FontSize="12" Margin="0,14,0,0"
                 TextWrapping="Wrap" LineHeight="20"
                 Foreground="{StaticResource HdText}" />

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="NoButton" Content="还是算了" Style="{StaticResource GhostButton}"
                Width="110" Margin="0,0,10,0" Click="OnNo" />
        <Button x:Name="YesButton" Content="当然" Style="{StaticResource DangerButton}"
                Width="110" Click="OnYes" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
