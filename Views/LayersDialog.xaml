<Window x:Class="HD2MM.Views.LayersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:m="clr-namespace:HD2MM.Models"
        Title="层链检查"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource HdBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="30" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Margin="20,52,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="当前补丁层分布" FontSize="14" FontWeight="SemiBold"
               Foreground="{StaticResource HdAccent}" />

    <TextBlock x:Name="SummaryText" Grid.Row="1" FontSize="10" Margin="0,6,0,0"
               Foreground="{StaticResource HdTextMuted}" />

    <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource HdSurface}"
            BorderBrush="{StaticResource HdBorder}" BorderThickness="1" CornerRadius="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
        <ItemsControl x:Name="GroupList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type m:LayerGroupView}">
              <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="{Binding Bundle}" FontFamily="Consolas" FontSize="11"
                             Foreground="{StaticResource HdText}" />
                  <TextBlock Text="{Binding ConflictText}" FontSize="9"
                             Foreground="#E5484D" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Sources}" ToolTip="{Binding Sources}" FontSize="10"
                           Margin="10,0,10,0" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{StaticResource HdTextMuted}" />

                <TextBlock Grid.Column="2" Text="{Binding LayerText}" FontSize="11"
                           Foreground="{StaticResource HdTextMuted}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                           Foreground="{StaticResource HdTextMuted}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="3" Content="关闭" Style="{StaticResource AccentButton}" Width="88"
            HorizontalAlignment="Right" Margin="0,14,0,0" Click="OnClose" />
  </Grid>
</Window>
